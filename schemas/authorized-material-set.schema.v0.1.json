{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:authorized-material-set:v0.1",
  "title": "Authorized material set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "purpose", "intendedProcessing", "sources"],
  "properties": {
    "schemaVersion": {
      "const": "openadam.authorized-material-set.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "intendedProcessing": {
      "enum": ["local-only", "caller-authorized-remote"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          { "pattern": "^(?:/|\\\\|[A-Za-z]:)" },
          { "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)" },
          { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" }
        ]
      }
    },
    "sourceBase": {
      "type": "object",
      "required": ["id", "role", "title", "location"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"
        },
        "role": {
          "enum": [
            "task-record",
            "conversation",
            "skill",
            "repository",
            "source-code",
            "documentation",
            "observer-snapshot",
            "web-research",
            "caller-summary",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "selectedRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "location": {}
      }
    },
    "localFileLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "local-file" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "localSelectionLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "root", "files"],
      "properties": {
        "type": { "const": "local-selection" },
        "root": { "$ref": "#/$defs/relativePath" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "referenceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "const": "reference" },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "role": true,
            "title": true,
            "observedAt": true,
            "selectedRange": true,
            "notes": true,
            "location": {
              "oneOf": [
                { "$ref": "#/$defs/localFileLocation" },
                { "$ref": "#/$defs/localSelectionLocation" },
                { "$ref": "#/$defs/referenceLocation" }
              ]
            }
          }
        }
      ]
    }
  }
}
