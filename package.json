{
  "name": "@openadam/agent-tool-development-kit",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Deterministic developer tooling for building and validating Agent tool products.",
  "author": "openAdam",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openadam-dev": "src/cli.mjs"
  },
  "files": [
    ".codex-plugin/",
    "docs/PRODUCT_MODEL.md",
    "docs/PROJECT_CONTRACT.md",
    "docs/REVIEW_CONTRACT.md",
    "docs/PILOT_MATRIX.md",
    "examples/",
    "schemas/",
    "skills/",
    "src/",
    "templates/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "build:component": "node scripts/build-developer-component.mjs --replace",
    "measure:self": "node scripts/measure-developer-kit.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "check": "npm run check:syntax && npm test && npm run check:schema && npm run check:distribution",
    "audit:production": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetracoralla/agent-tool-development-kit.git"
  },
  "homepage": "https://github.com/tetracoralla/agent-tool-development-kit#readme",
  "bugs": {
    "url": "https://github.com/tetracoralla/agent-tool-development-kit/issues"
  }
}
